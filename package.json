{
  "name": "star-of-the-west",
  "private": true,
  "version": "1.0.0",
  "description": "Star of the West: a QR-code learning game about the Star of the West Monument at The Citadel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --mode http",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "narration": "npm --prefix tools/narration install --no-fund --no-audit && node tools/narration/generate.mjs"
  },
  "dependencies": {
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
